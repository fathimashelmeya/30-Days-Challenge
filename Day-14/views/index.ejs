<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Greeting App</title>
    <style>
      body {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        font-family: Arial, Helvetica, sans-serif;
        background-color: #d260e9;
      }
      .card {
        text-align: center;
        padding: 30px;
        background-color: rgb(164, 41, 212);
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
      }
      h1 {
        color: #333;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Simple Calculator</h1>
      <h3><%=num1%> + <%= num2 %> = <%= sum %></h3>
    </div>
  </body>
</html>
